msgstr ""
"Iespējojot libdnf spraudņus, šiem spraudņu nosaukumu šabloniem netika "
"atrasta neviena atbilsme: {}"

#: main.cpp:1420
#, c++-format
msgid ""
"No matches were found for the following plugin name patterns while disabling "
"libdnf plugins: {}"
msgstr ""
"Atspējojot libdnf spraudņus, šiem spraudņu nosaukumu šabloniem netika "
"atrasta neviena atbilsme: {}"

