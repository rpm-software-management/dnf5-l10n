msgid "Show advisories containing any version of installed packages."
msgstr "Rādīt paziņojumus, kas satur jebkuru instalēto pakotņu versiju."

#: commands/advisory/arguments.hpp:45
msgid ""
"Show advisories containing newer versions of installed packages. This is the "
"default behavior."
msgstr ""
"Rādīt paziņojumus, kas satur instalēto pakotņu jaunākas versijas. Šī ir "
"noklusējuma uzvedība."

